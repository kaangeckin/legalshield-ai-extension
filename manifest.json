{
  "manifest_version": 3,
  "name": "LegalShield AI - ToS & Privacy Risk Analyzer",
  "version": "1.0.0",
  "description": "alibaba/page-agent entegrasyonlu, deterministik alıntı doğrulamalı ve Prompt Injection korumalı akıllı sözleşme ve gizlilik politikası denetçisi.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LegalShield AI Risk Panelini Aç",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
